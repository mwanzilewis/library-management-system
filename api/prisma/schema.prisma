generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(PATRON)
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  books Book[]
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  isbn        String   @unique
  publishedYr Int
  genreId     String
  genre       Genre    @relation(fields: [genreId], references: [id])
  reviews     Review[]
  createdAt   DateTime @default(now())
}

model Review {
  id      String   @id @default(cuid())
  rating  Int
  comment String?
  bookId  String
  book    Book     @relation(fields: [bookId], references: [id])
  userId  String
  user    User     @relation(fields: [userId], references: [id])
}
